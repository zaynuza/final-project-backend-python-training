# Salin jadi .env, lalu isi nilainya. File .env tidak di-commit (ada di .gitignore).
# Jalankan API dengan: uvicorn app.main:app --reload --no-access-log --env-file .env

# development = /docs aktif, production = /docs mati
ENV=development

# Wajib, minimal 32 karakter. Nilai di bawah sengaja kurang dari 32 karakter: API menolak start sampai Anda
# menggantinya. Jangan pernah menulis secret asli di file ini (file ini di-commit). Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=isi-dengan-hasil-token_hex
ACCESS_TOKEN_MINUTES=30

# Domain frontend yang boleh memanggil API dari browser, dipisah koma. Kosong = tidak ada.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/orders

# Batas login gagal per email (melawan brute force): gagal ke-5 dalam 15 menit = login berikutnya 429
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900
